{
  "name": "@make-kits/varicent-kit-2",
  "version": "0.1.0",
  "type": "module",
  "description": "Varicent UI design-system kit for Figma Make — v2, includes house-rules and full token/component reference",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@varicent/varicent-ui-core": "8.4.0",
    "@varicent/varicent-ui-icons": "8.4.0",
    "@varicent/varicent-ui-illustrations": "8.4.0",
    "@varicent/varicent-ui-tokens": "8.4.0",
    "react-intl": "7.1.14",
    "react-hook-form": "7.55.0",
    "react-router": "7.13.0",
    "recharts": "2.15.2",
    "motion": "12.23.24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guidelines/*": "./guidelines/*"
  },
  "figma": {
    "makeKit": {
      "kitType": "byoc",
      "formatVersion": 1
    }
  },
  "files": [
    "dist",
    "**/*.md"
  ],
  "scripts": {
    "build": "echo 'guidelines-only kit, no build needed'"
  }
}
